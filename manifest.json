{
  "manifest_version": 3,
  "name": "Sotto — local meeting transcripts",
  "version": "0.3.3",
  "description": "Captures live captions from Google Meet and Zoom (web) into local-only transcripts. No servers, no accounts, no telemetry.",
  "permissions": [
    "storage",
    "unlimitedStorage",
    "downloads"
  ],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://meet.google.com/*"
      ],
      "js": [
        "src/selectors.js",
        "src/capture.js",
        "src/adapters/meet.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*.zoom.us/wc/*"
      ],
      "js": [
        "src/selectors.js",
        "src/capture.js",
        "src/adapters/zoom.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "src/popup/popup.html",
    "default_title": "Sotto",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}